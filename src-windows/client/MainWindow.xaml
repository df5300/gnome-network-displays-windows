<Window x:Class="Gnd.Windows.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Gnd.Windows.Client"
        xmlns:vm="using:Gnd.Windows.Client.ViewModels"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        Title="Gnome Network Displays"
        Width="800"
        Height="600">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <controls:NavigationView>
        <controls:NavigationView.MenuItems>
            <controls:NavigationViewItem Content="Devices" Icon="CellWifi" Tag="Devices" IsSelected="True" />
            <controls:NavigationViewItem Content="Settings" Icon="Settings" Tag="Settings" />
        </controls:NavigationView.MenuItems>

        <ScrollViewer>
            <StackPanel Padding="20">
                <!-- Device list -->
                <TextBlock Text="Available Devices"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,10" />

                <ListView x:Name="DeviceList"
                          ItemsSource="{Binding Devices}"
                          SelectionMode="Single"
                          Margin="0,0,0,20">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceViewModel">
                            <Grid Padding="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:SymbolIcon Grid.Column="0"
                                                    Symbol="Display"
                                                    FontSize="32"
                                                    Margin="0,0,15,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind TypeDisplay}"
                                               Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="{x:Bind ConnectButtonText}"
                                        Command="{x:Bind ConnectCommand}"
                                        IsEnabled="{x:Bind CanConnect}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Status area -->
                <StackPanel x:Name="StatusArea"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,20,0,0">
                    <ProgressBar IsIndeterminate="True"
                                  Height="4"
                                  Margin="0,0,0,10" />
                    <TextBlock Text="{Binding StatusText}"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Refresh Devices"
                            Command="{Binding RefreshDevicesCommand}"
                            Margin="0,0,10,0" />
                    <Button Content="Start Discovery"
                            Command="{Binding StartDiscoveryCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </controls:NavigationView>
</Window>